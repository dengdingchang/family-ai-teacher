# Copy this file to .env. The start script creates .env automatically if absent.
# Keep the LLM key only in .env; never commit or print it.

APP_HOST=127.0.0.1
APP_PORT=8760
# Used only by scripts/start-tailscale.ps1. Tailscale Serve stays tailnet-only.
TAILSCALE_HTTPS_PORT=8443

# AI Station vLLM OpenAI-compatible API. Fill these three values locally.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
LLM_VISION_TIMEOUT_SECONDS=25

# Optional Codex built-in image generation. Uses the locally signed-in Codex account,
# not LLM_API_KEY or OPENAI_API_KEY. Keep both runtime directories under this project.
IMAGEGEN_ENABLED=0
IMAGEGEN_CODEX_PATH=codex
IMAGEGEN_AGENT_MODEL=gpt-5.6-sol
IMAGEGEN_TIMEOUT_SECONDS=180
IMAGEGEN_RETRY_BACKOFF_SECONDS=120
IMAGEGEN_SKILL_PATH=
IMAGEGEN_OUTPUT_DIR=runtime/generated-media
IMAGEGEN_JOBS_DIR=runtime/imagegen-jobs

# CPU is the default. CUDA requires a reviewed local model and matching DLLs.
# CUDA setup/runtime failure falls back once to this explicit CPU base model.
STT_PYTHON=X:\AI\faster-whisper-offline\python-3.10.11-embed-amd64\python.exe
STT_MODEL_PATH=X:\AI\faster-whisper-offline\models\models--Systran--faster-whisper-base\snapshots\ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66
STT_LANGUAGE=zh
STT_COMPUTE_TYPE=int8
STT_DEVICE=cpu
STT_CUDA_LIBRARY_DIR=
STT_FALLBACK_MODEL_PATH=X:\AI\faster-whisper-offline\models\models--Systran--faster-whisper-base\snapshots\ebe41f70d5b6dfa9166e2c581c45c9c0cfc57b66
# The reviewed CUDA bundle is X:\AI\OmniVoice-Studio\.venv\Lib\site-packages\torch\lib.
# It must byte-match CTranslate2's main cuDNN DLL; no DLLs or global PATH are changed.

# remote_preferred uses the same Nathan model on AI Station with local fallback.
# streaming uses the existing local checkpoint through the isolated accelerated runtime.
# Set streaming only after the isolated runtime is prepared and smoke-tested.
TTS_MODE=remote_preferred
TTS_STREAMING_PYTHON=X:\Workspace\family-ai-teacher\runtime\tts-streaming-probe-venv\Scripts\python.exe
TTS_PROMPT_MODE=speaker_vector
TTS_REMOTE_BASE_URL=http://127.0.0.1:8792
TTS_REMOTE_TIMEOUT_SECONDS=12
TTS_REMOTE_RETRY_COOLDOWN_SECONDS=30
TTS_CPU=0
TTS_PYTHON=X:\AI\local\qwen3-tts-runtime311\.venv\Scripts\python.exe
TTS_RUNNER=X:\AI\local\qwen3-tts-runtime311\qwen3_clone.py
TTS_MODEL=X:\AI\local\qwen3-tts-models\Qwen3-TTS-12Hz-1.7B-Base
TTS_REF_AUDIO=X:\UserData\Desktop\暴富工具素材\08_配音\raw\nathan_voice_v2_reference.wav
TTS_REF_TEXT_FILE=X:\AI\local\qwen3-tts-runtime311\nathan_reference_matrix.json
TTS_LANGUAGE=Chinese
TTS_DTYPE=float16

# Optional. Leave empty to use the project-owned non-photographic fallback.
AVATAR_IMAGE_PATH=frontend/nathan-avatar-neutral.png
# Optional reviewed owner footage loop (MP4 only); empty uses the photo.
AVATAR_IDLE_PATH=
AVATAR_WS_URL=ws://127.0.0.1:8791
AVATAR_AUDIO_LEAD_MS=900
