[Unit]
Description=Family Teacher independent application (loopback)
After=network-online.target family-ai-soulx.service family-ai-tts.service
PartOf=family-ai-tts.service
BindsTo=family-ai-tts.service

[Service]
WorkingDirectory=/home/selfhost/family-ai-teacher/app-live
EnvironmentFile=/home/selfhost/family-ai-teacher/app-live/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/selfhost/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/selfhost
Environment=LD_LIBRARY_PATH=/home/selfhost/family-ai-teacher/runtime/tts/.venv/lib/python3.10/site-packages/nvidia/cublas/lib:/home/selfhost/family-ai-teacher/runtime/tts/.venv/lib/python3.10/site-packages/nvidia/cudnn/lib
ExecStart=/home/selfhost/family-ai-teacher/runtime/teacher-app/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18760 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
MemoryMax=24G

[Install]
WantedBy=family-ai-tts.service
